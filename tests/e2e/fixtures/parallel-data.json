{
  "test_cases": [
    {
      "name": "Standard 90 Degree Offset - Steel",
      "params": {
        "outer_diameter": 25,
        "wall_thickness": 2.0,
        "bend_angle": 90,
        "offset_distance": 50,
        "bend_radius": 40,
        "material": "Steel"
      },
      "expected": {
        "total_length_approx": 120,
        "bend_angles": [90, 90],
        "is_valid": true,
        "confidence_min": 0.85
      }
    },
    {
      "name": "45 Degree Offset - Aluminum",
      "params": {
        "outer_diameter": 19.05,
        "wall_thickness": 1.5,
        "bend_angle": 45,
        "offset_distance": 35,
        "bend_radius": 35,
        "material": "Aluminum"
      },
      "expected": {
        "total_length_approx": 95,
        "bend_angles": [45, 45],
        "is_valid": true,
        "confidence_min": 0.80
      }
    },
    {
      "name": "Large Diameter - Stainless Steel",
      "params": {
        "outer_diameter": 50.8,
        "wall_thickness": 2.4,
        "bend_angle": 90,
        "offset_distance": 80,
        "bend_radius": 80,
        "material": "Stainless Steel"
      },
      "expected": {
        "total_length_approx": 200,
        "bend_angles": [90, 90],
        "is_valid": true,
        "confidence_min": 0.80
      }
    },
    {
      "name": "Small Diameter - Copper",
      "params": {
        "outer_diameter": 6.35,
        "wall_thickness": 0.5,
        "bend_angle": 90,
        "offset_distance": 20,
        "bend_radius": 15,
        "material": "Copper"
      },
      "expected": {
        "total_length_approx": 50,
        "bend_angles": [90, 90],
        "is_valid": true,
        "confidence_min": 0.75
      }
    },
    {
      "name": "Minimum Angle (5 degrees) - Titanium",
      "params": {
        "outer_diameter": 25,
        "wall_thickness": 2.0,
        "bend_angle": 5,
        "offset_distance": 10,
        "bend_radius": 50,
        "material": "Titanium"
      },
      "expected": {
        "total_length_approx": 60,
        "is_valid": true,
        "confidence_min": 0.70
      }
    },
    {
      "name": "Maximum Angle (175 degrees) - Brass",
      "params": {
        "outer_diameter": 25,
        "wall_thickness": 2.0,
        "bend_angle": 175,
        "offset_distance": 50,
        "bend_radius": 50,
        "material": "Brass"
      },
      "expected": {
        "total_length_approx": 110,
        "is_valid": true,
        "confidence_min": 0.60
      }
    },
    {
      "name": "Complex Configuration - Multiple Materials",
      "params": {
        "outer_diameter": 38.1,
        "wall_thickness": 1.65,
        "bend_angle": 60,
        "offset_distance": 60,
        "bend_radius": 60,
        "material": "Steel"
      },
      "expected": {
        "total_length_approx": 150,
        "is_valid": true,
        "confidence_min": 0.82
      }
    }
  ],
  "edge_cases": [
    {
      "name": "Invalid - Negative Diameter",
      "params": {
        "outer_diameter": -25,
        "wall_thickness": 2.0,
        "bend_angle": 90,
        "offset_distance": 50,
        "bend_radius": 40,
        "material": "Steel"
      },
      "should_error": true,
      "error_type": "validation"
    },
    {
      "name": "Invalid - Wall Thickness Too Large",
      "params": {
        "outer_diameter": 25,
        "wall_thickness": 20.0,
        "bend_angle": 90,
        "offset_distance": 50,
        "bend_radius": 40,
        "material": "Steel"
      },
      "should_error": true,
      "error_type": "validation"
    },
    {
      "name": "Invalid - Angle > 180",
      "params": {
        "outer_diameter": 25,
        "wall_thickness": 2.0,
        "bend_angle": 185,
        "offset_distance": 50,
        "bend_radius": 40,
        "material": "Steel"
      },
      "should_error": true,
      "error_type": "validation"
    },
    {
      "name": "Invalid - Angle < 0",
      "params": {
        "outer_diameter": 25,
        "wall_thickness": 2.0,
        "bend_angle": -45,
        "offset_distance": 50,
        "bend_radius": 40,
        "material": "Steel"
      },
      "should_error": true,
      "error_type": "validation"
    },
    {
      "name": "Invalid - Zero Bend Radius",
      "params": {
        "outer_diameter": 25,
        "wall_thickness": 2.0,
        "bend_angle": 90,
        "offset_distance": 50,
        "bend_radius": 0,
        "material": "Steel"
      },
      "should_error": true,
      "error_type": "validation"
    },
    {
      "name": "Invalid - Negative Offset Distance",
      "params": {
        "outer_diameter": 25,
        "wall_thickness": 2.0,
        "bend_angle": 90,
        "offset_distance": -50,
        "bend_radius": 40,
        "material": "Steel"
      },
      "should_error": true,
      "error_type": "validation"
    }
  ]
}
