{
  "name": "bendcore-backend",
  "version": "1.0.0",
  "description": "BendCore Web Backend - REST API for tube bending design",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src"
  },
  "keywords": [
    "CAD",
    "tube",
    "bending",
    "REST",
    "API"
  ],
  "author": "Do4ent",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/jest": "^29.5.2",
    "@types/cors": "^2.8.13",
    "@types/uuid": "^9.0.2",
    "typescript": "^5.1.3",
    "ts-node": "^10.9.1",
    "ts-jest": "^29.1.0",
    "jest": "^29.5.0",
    "eslint": "^8.42.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "prettier": "^2.8.8",
    "sqlite3": "^5.1.6",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
