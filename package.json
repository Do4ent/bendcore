{
  "name": "bendcore-ui",
  "version": "2.0.0",
  "description": "BendCore CAD - Professional 3D CAD system for tube bending design and manufacturing",
  "main": "dist/main.js",
  "homepage": "https://github.com/Do4ent/bendcore",
  "repository": {
    "type": "git",
    "url": "https://github.com/Do4ent/bendcore.git"
  },
  "scripts": {
    "dev": "electron . --debug",
    "build": "tsc && webpack",
    "test": "jest",
    "lint": "eslint src/ui --ext .ts,.tsx",
    "format": "prettier --write src/ui",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [
    "CAD",
    "3D",
    "tube",
    "bending",
    "manufacturing",
    "design"
  ],
  "author": "Do4ent",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^r128.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.1.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "ts-loader": "^9.4.0",
    "style-loader": "^3.3.0",
    "css-loader": "^6.8.0",
    "postcss-loader": "^7.3.0",
    "electron": "^25.0.0",
    "electron-builder": "^24.4.0",
    "@babel/core": "^7.22.0",
    "@babel/preset-typescript": "^7.22.0",
    "babel-loader": "^9.1.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.1.0",
    "prettier": "^3.0.0",
    "eslint": "^8.42.0",
    "eslint-plugin-react": "^7.32.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "build": {
    "appId": "com.do4ent.bendcore",
    "productName": "BendCore CAD",
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "msi"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
