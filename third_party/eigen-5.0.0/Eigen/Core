// Minimal Eigen Mock for Phase 4 Testing
// This provides enough to compile tests without full Eigen dependency

#ifndef EIGEN_CORE_H
#define EIGEN_CORE_H

#include <vector>
#include <cmath>
#include <cassert>
#include <algorithm>
#include <stdexcept>
#include <memory>

namespace Eigen {
    using Index = long long;

    // Forward declarations
    template<typename T> class Map;
    template<typename T> class JacobiSVD;
    class MatrixXd;

    // Dynamic vector class
    class VectorXd {
    public:
        std::vector<double> data_;

        VectorXd() = default;
        explicit VectorXd(Index size) : data_(size, 0.0) {}
        VectorXd(const VectorXd& other) = default;
        VectorXd& operator=(const VectorXd& other) = default;

        Index size() const { return static_cast<Index>(data_.size()); }
        double* data() { return data_.data(); }
        const double* data() const { return data_.data(); }

        double& operator()(Index i) { return data_[i]; }
        const double& operator()(Index i) const { return data_[i]; }
        double& operator[](Index i) { return data_[i]; }
        const double& operator[](Index i) const { return data_[i]; }

        VectorXd operator+(const VectorXd& other) const {
            VectorXd result = *this;
            for (size_t i = 0; i < data_.size(); ++i) result.data_[i] += other.data_[i];
            return result;
        }

        VectorXd operator-(const VectorXd& other) const {
            VectorXd result = *this;
            for (size_t i = 0; i < data_.size(); ++i) result.data_[i] -= other.data_[i];
            return result;
        }

        VectorXd operator*(double scalar) const {
            VectorXd result = *this;
            for (auto& v : result.data_) v *= scalar;
            return result;
        }

        VectorXd operator/(double scalar) const {
            return (*this) * (1.0 / scalar);
        }

        VectorXd operator-() const {
            return (*this) * (-1.0);
        }

        double dot(const VectorXd& other) const {
            double sum = 0.0;
            for (size_t i = 0; i < data_.size(); ++i) sum += data_[i] * other.data_[i];
            return sum;
        }

        double norm() const { return std::sqrt(dot(*this)); }

        double squaredNorm() const { return dot(*this); }

        VectorXd transpose() const {
            return *this;  // Vectors are same when transposed in this mock
        }

        void setZero() {
            for (auto& v : data_) v = 0.0;
        }

        void setZero(Index n) {
            data_.resize(n, 0.0);
        }

        VectorXd normalized() const {
            double n = norm();
            if (n < 1e-15) return VectorXd(size());
            return (*this) * (1.0 / n);
        }

        friend class MatrixXd;
        template<typename T> friend class Map;
    };

    // Helper class for diagonal access
    class DiagonalProxy {
    public:
        std::vector<std::vector<double>>& data_;
        Index size_;

        DiagonalProxy(std::vector<std::vector<double>>& data, Index size)
            : data_(data), size_(size) {}

        void setZero() { /* Do nothing - diagonal already initialized */ }

        class ArrayProxy {
        public:
            std::vector<std::vector<double>>& data_;
            Index size_;

            ArrayProxy(std::vector<std::vector<double>>& data, Index size)
                : data_(data), size_(size) {}

            ArrayProxy& operator+=(double val) {
                for (Index i = 0; i < size_; ++i) {
                    data_[i][i] += val;
                }
                return *this;
            }
        };

        ArrayProxy array() {
            return ArrayProxy(data_, size_);
        }
    };

    // LDLT decomposition - defined separately
    class LDLTDecomposition {
    public:
        std::vector<std::vector<double>> data_;
        Index rows_ = 0, cols_ = 0;

        explicit LDLTDecomposition(const MatrixXd& m);

        VectorXd solve(const VectorXd& b) const;
    };

    // Dynamic matrix class
    class MatrixXd {
    public:
        std::vector<std::vector<double>> data_;
        Index rows_ = 0, cols_ = 0;

        MatrixXd() = default;
        MatrixXd(Index r, Index c) : rows_(r), cols_(c) {
            data_.resize(r, std::vector<double>(c, 0.0));
        }

        MatrixXd(const MatrixXd& other) = default;
        MatrixXd& operator=(const MatrixXd& other) = default;

        Index rows() const { return rows_; }
        Index cols() const { return cols_; }
        Index size() const { return rows_ * cols_; }

        double& operator()(Index i, Index j) { return data_[i][j]; }
        const double& operator()(Index i, Index j) const { return data_[i][j]; }

        VectorXd col(Index j) const {
            VectorXd v(rows_);
            for (Index i = 0; i < rows_; ++i) v[i] = data_[i][j];
            return v;
        }

        MatrixXd transpose() const {
            MatrixXd result(cols_, rows_);
            for (Index i = 0; i < rows_; ++i) {
                for (Index j = 0; j < cols_; ++j) {
                    result(j, i) = data_[i][j];
                }
            }
            return result;
        }

        VectorXd operator*(const VectorXd& v) const {
            assert(cols_ == v.size());
            VectorXd result(rows_);
            for (Index i = 0; i < rows_; ++i) {
                for (Index j = 0; j < cols_; ++j) {
                    result[i] += data_[i][j] * v[j];
                }
            }
            return result;
        }

        MatrixXd operator*(const MatrixXd& m) const {
            assert(cols_ == m.rows());
            MatrixXd result(rows_, m.cols());
            for (Index i = 0; i < rows_; ++i) {
                for (Index j = 0; j < m.cols(); ++j) {
                    for (Index k = 0; k < cols_; ++k) {
                        result(i, j) += data_[i][k] * m(k, j);
                    }
                }
            }
            return result;
        }

        DiagonalProxy diagonal() {
            return DiagonalProxy(data_, std::min(rows_, cols_));
        }

        void setZero(Index r, Index c) {
            rows_ = r;
            cols_ = c;
            data_.assign(r, std::vector<double>(c, 0.0));
        }

        void setZero() {
            for (auto& row : data_) {
                for (auto& val : row) val = 0.0;
            }
        }

        LDLTDecomposition ldlt() const;

        VectorXd ldlt_solve(const VectorXd& b) const {
            return ldlt().solve(b);
        }
    };

    // Implement LDLT methods now that MatrixXd is complete
    inline LDLTDecomposition::LDLTDecomposition(const MatrixXd& m)
        : data_(m.data_), rows_(m.rows_), cols_(m.cols_) {}

    inline VectorXd LDLTDecomposition::solve(const VectorXd& b) const {
        std::vector<std::vector<double>> L = data_;
        VectorXd x = b;

        // Simple Gaussian elimination
        for (Index k = 0; k < rows_ - 1; ++k) {
            Index max_row = k;
            for (Index i = k + 1; i < rows_; ++i) {
                if (std::abs(L[i][k]) > std::abs(L[max_row][k])) {
                    max_row = i;
                }
            }
            std::swap(L[k], L[max_row]);
            std::swap(x.data_[k], x.data_[max_row]);

            for (Index i = k + 1; i < rows_; ++i) {
                if (std::abs(L[k][k]) < 1e-15) continue;
                double factor = L[i][k] / L[k][k];
                for (Index j = k; j < cols_; ++j) {
                    L[i][j] -= factor * L[k][j];
                }
                x.data_[i] -= factor * x.data_[k];
            }
        }

        // Back substitution
        for (Index i = rows_ - 1; i >= 0; --i) {
            for (Index j = i + 1; j < cols_; ++j) {
                x.data_[i] -= L[i][j] * x.data_[j];
            }
            if (std::abs(L[i][i]) > 1e-15) {
                x.data_[i] /= L[i][i];
            }
        }

        return x;
    }

    inline LDLTDecomposition MatrixXd::ldlt() const {
        return LDLTDecomposition(*this);
    }

    // Template specialization for Map<const VectorXd>
    template<>
    class Map<const VectorXd> : public VectorXd {
    public:
        Map(const double* ptr, Index size) {
            data_.assign(ptr, ptr + size);
        }
    };

    template<>
    class Map<VectorXd> : public VectorXd {
    public:
        Map(double* ptr, Index size) {
            data_.assign(ptr, ptr + size);
        }
    };

    // JacobiSVD for simple SVD operations
    template<typename MatrixType>
    class JacobiSVD {
    public:
        MatrixType U;
        MatrixType V;
        VectorXd singular_values_;

        explicit JacobiSVD(const MatrixType& mat) {
            // Simplified: just store identity for U, transpose for V, and unit singular values
            Index m = mat.rows();
            Index n = mat.cols();
            Index min_mn = std::min(m, n);

            U = MatrixType(m, min_mn);
            V = MatrixType(n, min_mn);
            singular_values_ = VectorXd(min_mn);

            // Set to identity-like structure
            for (Index i = 0; i < min_mn; ++i) {
                singular_values_[i] = 1.0;
                for (Index j = 0; j < min_mn; ++j) {
                    U(i, j) = (i == j) ? 1.0 : 0.0;
                    V(i, j) = (i == j) ? 1.0 : 0.0;
                }
            }
        }

        VectorXd singularValues() const {
            return singular_values_;
        }
    };
}

// Provide generic template forward declaration outside namespace
template<typename T>
class Eigen::Map {};

#endif // EIGEN_CORE_H
