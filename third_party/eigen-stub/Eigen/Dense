    // LDLT decomposition stub
    class LDLT {
    public:
        LDLT() {}
        LDLT(const MatrixXd& m) {}

        VectorXd solve(const VectorXd& b) const {
            return VectorXd(b.size());
        }
    };

    // Partial pivot LU stub
    class PartialPivLU {
    public:
        PartialPivLU() {}
        explicit PartialPivLU(const MatrixXd& m) {}

        VectorXd solve(const VectorXd& b) const {
            return VectorXd(b.size());
        }
    };

    // JacobiSVD stub
    class JacobiSVD {
    public:
        std::vector<double> singular_values_;

        JacobiSVD() {}
        explicit JacobiSVD(const MatrixXd& m) : singular_values_(std::min(m.rows(), m.cols()), 0) {}

        VectorXd singularValues() const {
            return VectorXd(singular_values_);
        }
    };

    // Extension for LDLT
    inline LDLT MatrixXd::ldlt() const {
        return LDLT(*this);
    }
