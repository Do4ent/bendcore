# BendCore Web - Environment Configuration
# Copy this file to .env and update with your values

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://bendcore:bendcore_dev_password@postgres:5432/bendcore
DB_HOST=postgres
DB_PORT=5432
DB_USER=bendcore
DB_PASSWORD=bendcore_dev_password
DB_NAME=bendcore

# Redis Cache
REDIS_URL=redis://:@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# API Configuration
API_PORT=3001
API_HOST=0.0.0.0
API_PROTOCOL=http

# Frontend
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME=BendCore Web
VITE_APP_VERSION=1.0.0

# CORS
CORS_ORIGIN=http://localhost
CORS_CREDENTIALS=true

# Security
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production
SESSION_SECRET=your-super-secret-session-key-change-me-in-production
ENCRYPTION_KEY=your-encryption-key-change-me-in-production

# Authentication
AUTH_ENABLED=true
AUTH_PROVIDER=local

# Email (Optional)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@bendcore.app

# Monitoring (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# AWS (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=pdf,dxf,stp,step

# Feature Flags
FEATURE_API_DOCS=true
FEATURE_IMPORT_EXPORT=true
FEATURE_COLLABORATION=false
FEATURE_ADVANCED_REPORTING=false

# GrowthBook A/B Testing and Feature Flags
REACT_APP_GROWTHBOOK_API_KEY=
REACT_APP_VERSION=2.0.0
GROWTHBOOK_API_HOST=https://api.growthbook.io
